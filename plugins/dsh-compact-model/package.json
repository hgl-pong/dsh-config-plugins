{
  "name": "dsh-compact-model",
  "version": "0.1.0",
  "description": "DSH plugin: 控制 ACP 压缩(compact)使用的模型与 provider。只能选择支持关闭推理(reasoning off)的模型，通过 settings 页 /compact-model 命令设置，并在运行时把压缩请求改写为所选模型。",
  "author": "llt",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT"
}
